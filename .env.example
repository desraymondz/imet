# Database
POSTGRES_USER=imet
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=imet_db
DATABASE_URL=postgresql://imet:your_password_here@postgres:5432/imet_db
DEBUG=false

# Auth
SECRET_KEY=change-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Ollama local inference
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_FAST=llama3.2:3b
OLLAMA_MODEL_QUALITY=llama3.2:3b

# If API runs in Docker but Ollama runs machine locally
# OLLAMA_HOST=http://host.docker.internal:11434

# Embeddings model (sentence-transformers)
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Recall search
RECALL_MIN_SCORE=0.35
RECALL_MAX_CANDIDATES=20